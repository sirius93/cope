# Copy to .env and fill in. Never committed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# COPE studio (`cope review`). The server checks the login on every request. Required
# when COPE_PUBLIC_HOST is set; the password must then be at least 12 characters.
COPE_STUDIO_USER=
COPE_STUDIO_PASSWORD=
# Custom domain served through `cope review --tunnel <name>`, e.g. cope.example.com
COPE_PUBLIC_HOST=
