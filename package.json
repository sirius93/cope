{
  "name": "cope",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "cope": "node --import tsx packages/cli/src/index.ts",
    "typecheck": "tsc --noEmit -p packages/providers && tsc --noEmit -p packages/formats && tsc --noEmit -p packages/render && tsc --noEmit -p packages/core && tsc --noEmit -p packages/cli",
    "test": "node --import tsx --test packages/*/src/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "license": "MIT",
  "packageManager": "pnpm@10.11.1"
}
